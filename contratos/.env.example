# Configuracao do ambiente de contratos do AgroSmart.
#
# Copie para .env e preencha. O .env esta no .gitignore e NUNCA deve ser enviado
# ao repositorio (RNF16).
#
# Para trabalhar apenas em rede local (`npx hardhat node`), nada aqui e
# obrigatorio: o Hardhat ja fornece contas com saldo.

# --- rede de teste publica (Sepolia) --------------------------------------

# Endpoint JSON-RPC. Provedores usuais: Infura, Alchemy, Ankr.
RPC_SEPOLIA=

# Chave privada da carteira da seguradora, que implanta os contratos e deposita
# a garantia. Use uma carteira de teste criada so para isso.
CHAVE_PRIVADA_SEGURADORA=

# Chave privada da carteira do oraculo. Precisa ser um endereco diferente do da
# seguradora e do produtor: e o que mantem a separacao de papeis do RNF12.
CHAVE_PRIVADA_ORACULO=

# Endereco do oraculo a autorizar no registro. Se ficar em branco, o script de
# implantacao usa a terceira conta disponivel na rede.
ENDERECO_ORACULO=

# Chave da API do Etherscan, para verificar o codigo-fonte dos contratos e
# permitir que a banca leia o contrato implantado no explorador de blocos.
ETHERSCAN_API_KEY=

# --- relatorio de gas ------------------------------------------------------

# Defina como "true" para o hardhat-gas-reporter medir cada funcao (RNF09).
REPORT_GAS=

# Arquivo de saida do relatorio. Em branco, imprime no terminal.
GAS_OUTPUT_FILE=

# --- emissao de apolice (scripts/emitir-apolice.js) ------------------------

ENDERECO_PRODUTOR=
LIMIAR_DIAS=30
VALOR_INDENIZACAO=1.0
CULTURA=soja
TALHAO=talhao-01
