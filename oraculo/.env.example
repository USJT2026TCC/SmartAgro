# Configuracao do servico de oraculo do AgroSmart.
#
# Copie este arquivo para .env e preencha. O .env esta no .gitignore e NUNCA
# deve ser enviado ao repositorio (RNF16).
#
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

# Rede em que o oraculo publica. Precisa bater com o nome do arquivo gerado em
# contratos/implantacoes/<rede>.json
REDE=localhost

# Endpoint JSON-RPC.
#   rede local:  http://127.0.0.1:8545
#   Sepolia:     https://sepolia.infura.io/v3/<sua-chave>  (ou outro provedor)
RPC_URL=http://127.0.0.1:8545

# Chave privada do endereco autorizado no OracleRegistry.
#
# Em rede local, use uma das chaves que o `npx hardhat node` imprime no terminal.
# Em Sepolia, use a chave de uma carteira de teste criada so para isso, nunca uma
# carteira com valor real.
CHAVE_PRIVADA_ORACULO=

# Endereco da apolice, para nao ter de passar --apolice em todo comando.
ENDERECO_APOLICE=

# --- parametros da consolidacao -------------------------------------------

# Chuva diaria, em milimetros, abaixo da qual o dia conta como seco.
LIMIAR_CHUVA_MM=1

# Escore minimo de reputacao para que as leituras de uma fonte sejam usadas (RF13).
LIMIAR_REPUTACAO=0.5

# Confianca minima do modelo de visao para publicar sem revisao do perito (RF17).
LIMIAR_CONFIANCA_MODELO=0.7

# --- tolerancia a falhas (RF21) -------------------------------------------

# Tentativas de publicacao antes de a entrada ser marcada como falha definitiva.
MAX_TENTATIVAS=5

# Espera inicial entre tentativas, em milissegundos. Dobra a cada tentativa.
ESPERA_BASE_MS=2000

# Confirmacoes aguardadas antes de considerar a publicacao concluida.
# Em rede local, 1 basta. Em Sepolia, 2 reduz o risco de reorganizacao de bloco.
CONFIRMACOES=1
