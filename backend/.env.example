# Configuracao do backend do AgroSmart.
#
# Copie para .env e ajuste. O .env esta no .gitignore e NUNCA deve ir para o
# repositorio (RNF16). Em desenvolvimento, nada aqui e obrigatorio: os padroes
# sobem a API com o banco embutido e a rede local.

PORTA=3001

# --- banco -----------------------------------------------------------------

# Vazio: usa o PostgreSQL embutido (PGlite), com PostGIS, gravado em DIR_BANCO.
# Preenchido: usa um PostgreSQL de verdade, que precisa ter a extensao PostGIS.
#   exemplo: postgres://usuario:senha@localhost:5432/agrosmart
DATABASE_URL=
DIR_BANCO=

# --- segredos --------------------------------------------------------------
# Em producao (NODE_ENV=producao), a ausencia de qualquer um derruba o servico.
# Gere valores com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Chave que o servico de oraculo e o modulo de visao usam para chamar a API.
# O mesmo valor precisa estar em oraculo/.env (CHAVE_DE_SERVICO).
CHAVE_DE_SERVICO=

# Chave de cifra do segredo do segundo fator (TOTP), guardado cifrado no banco.
SEGREDO_DE_CIFRA=

# --- cadeia ----------------------------------------------------------------

# Precisa bater com o arquivo em contratos/implantacoes/<rede>.json
REDE=localhost
RPC_URL=http://127.0.0.1:8545

# Intervalo entre varreduras do indexador de eventos, em milissegundos.
INTERVALO_INDEXADOR_MS=4000

# "desligado" desativa o indexador (os testes fazem isso).
INDEXADOR=

# --- aplicativo ------------------------------------------------------------

# Origem liberada no CORS. Em desenvolvimento o Vite faz proxy de /api e o CORS
# nem chega a ser usado.
ORIGEM_APP=http://localhost:5173

HORAS_DE_SESSAO=8

# --- limites (RNF26) -------------------------------------------------------

LIMITE_LOGIN=10
LIMITE_INGESTAO=120

# Janela aceita para a marca de tempo de um lote de leituras, em minutos.
JANELA_LOTE_MIN=10

# Abaixo desta confianca (em pontos-base), a analise de imagem vai para o perito.
LIMIAR_CONFIANCA_BPS=7000
