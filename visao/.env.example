# Backend do AgroSmart
API_URL=http://localhost:3001/api

# A MESMA chave definida em backend/.env. Sem ela, o backend recusa o servico.
CHAVE_DE_SERVICO=

# Modelo treinado. Sem estas duas, o modulo usa a heuristica de cor de
# baseline.py, cuja confianca fica abaixo do limiar de proposito: toda analise
# vai para o perito, e nenhuma aciona pagamento sozinha.
# Em operacao: o bat-resnet18-r3 (U-Net com codificador ResNet-18 pre-treinado,
# 4.0.0), copiado para pesos/unet.pt. Os pesos NAO estao no Git: o SHA-256 do
# arquivo em uso e 2c428d64e907b70d2a2d878bc5101f439767f2caf2c4cdc2ac13deb28198bb55
# (docs/resultados/visao-bateria-2026-10-15). Confira com Get-FileHash.
VISAO_PESOS=pesos/unet.pt
VISAO_VERSAO=visao-unet-resnet18-4.0.0
